<Window x:Class="RestaurantPOS.WpfApp.Views.ShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RestaurantPOS.WpfApp.ViewModels"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Ca làm việc" Height="620" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.DataContext>
        <vm:ShiftViewModel />
    </Window.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Ca làm việc" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />

            <TextBlock Text="Giờ ca quy định của tôi" FontWeight="Bold" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBox Text="{Binding ScheduledStartInput, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                <TextBlock Text=" - " VerticalAlignment="Center" />
                <TextBox Text="{Binding ScheduledEndInput, UpdateSourceTrigger=PropertyChanged}" Width="70" />
            </StackPanel>
            <Button Content="Lưu giờ quy định" Command="{Binding SaveScheduledHoursCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" />

            <StackPanel Visibility="{Binding HasOpenShift, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding UserFullName, StringFormat='Người đứng ca: {0}'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding OpenShift.OpenedAt, StringFormat='Mở ca lúc: {0:HH:mm dd/MM/yyyy}'}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding ElapsedText, StringFormat='Thời gian hoạt động: {0}'}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Reconciliation.OpeningCash, StringFormat='Tiền đầu ca: {0:N0} đ'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Reconciliation.CashPayments, StringFormat='Doanh thu tiền mặt: {0:N0} đ'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Reconciliation.ExpectedCash, StringFormat='Tiền dự kiến trong két: {0:N0} đ'}" FontWeight="Bold" Margin="0,0,0,16" />

                <TextBlock Text="Tiền cuối ca (kiểm đếm thực tế)" Margin="0,0,0,4" />
                <TextBox Text="{Binding ClosingCash, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Variance, StringFormat='Chênh lệch: {0:N0} đ'}" Margin="0,0,0,16" />

                <Button Content="Đóng ca" Command="{Binding CloseShiftCommand}" Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>

            <StackPanel Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Tóm tắt ca vừa đóng" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding LastClosedSummary.UserFullName, StringFormat='Người mở ca: {0}'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LastClosedSummary.OpeningCash, StringFormat='Tiền đầu két: {0:N0} đ'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LastClosedSummary.ClosingCash, StringFormat='Tiền cuối két: {0:N0} đ'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LastClosedSummary.WorkedDuration, StringFormat='Thời gian làm việc: {0:hh\\:mm}'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LastClosedSummary.ClosedAt, StringFormat='Giờ đóng ca (checkout thực tế): {0:HH:mm}'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LastClosedSummary.ScheduledStart, StringFormat='Giờ vào ca quy định: {0:hh\\:mm}'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LastClosedSummary.OpenedAt, StringFormat='Giờ vào ca thực tế: {0:HH:mm}'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LastClosedSummary.ScheduledEnd, StringFormat='Giờ checkout quy định: {0:hh\\:mm}'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LastClosedSummary.CashPayments, StringFormat='Doanh thu tiền mặt: {0:N0} đ'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LastClosedSummary.ExpectedCash, StringFormat='Tiền dự kiến trong két: {0:N0} đ'}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LastClosedSummary.Variance, StringFormat='Chênh lệch: {0:N0} đ'}" FontWeight="Bold" Margin="0,0,0,16" />
                <Button Content="In báo cáo ca" Command="{Binding PrintShiftReportCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                <Button Content="Đóng" Command="{Binding DismissSummaryCommand}" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Visibility="{Binding ShowNoShiftPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Chưa mở ca." Margin="0,0,0,16" Foreground="Gray" />
                <TextBlock Text="Tiền đầu ca" Margin="0,0,0,4" />
                <TextBox Text="{Binding OpeningCash, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                <Button Content="Mở ca" Command="{Binding OpenShiftCommand}" Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>

            <Button x:Name="BtnSkip" Content="Bỏ qua" Click="BtnSkip_Click" Visibility="Collapsed" Margin="0,16,0,0" />
            <Button x:Name="BtnExit" Content="Thoát ứng dụng" Click="BtnExit_Click" Visibility="Collapsed" Foreground="Red" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
